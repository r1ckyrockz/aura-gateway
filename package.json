{
  "name": "aura-gateway",
  "version": "0.1.0",
  "description": "AURA Gateway — the local-first brain API of AURA: connects voice satellites and apps to local LLMs and Home Assistant, with tool calling, household policies and confirmations.",
  "license": "Apache-2.0",
  "author": "Riccardo Carano",
  "keywords": [
    "aura",
    "home-assistant",
    "voice-assistant",
    "local-llm",
    "nestjs",
    "ollama",
    "openai-compatible",
    "smart-home",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r1ckyrockz/aura-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/r1ckyrockz/aura-gateway/issues"
  },
  "homepage": "https://github.com/r1ckyrockz/aura-gateway#readme",
  "engines": {
    "node": ">=22.12"
  },
  "private": false,
  "scripts": {
    "build": "rimraf dist && nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
