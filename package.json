{
  "name": "aura-gateway",
  "version": "0.1.0",
  "description": "AURA Gateway — the local-first brain API of AURA: connects voice satellites and apps to local LLMs and Home Assistant, with tool calling, household policies and confirmations.",
  "license": "Apache-2.0",
  "author": "Riccardo Carano",
  "keywords": [
    "aura",
    "home-assistant",
    "voice-assistant",
    "local-llm",
    "nestjs",
    "ollama",
    "openai-compatible",
    "smart-home",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r1ckyrockz/aura-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/r1ckyrockz/aura-gateway/issues"
  },
  "homepage": "https://github.com/r1ckyrockz/aura-gateway#readme",
  "engines": {
    "node": ">=22"
  },
  "private": false,
  "scripts": {
    "build": "rimraf dist && nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.1.1",
    "@nestjs/swagger": "^12.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~7.0",
    "typescript-eslint": "^8.72.0"
  }
}
